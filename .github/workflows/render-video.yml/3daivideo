name: Render Video 3D

# Otomatis berjalan setiap ada klip/narasi baru di video/input/,
# atau dijalankan manual dari tab Actions (tombol "Run workflow").
on:
  push:
    paths:
      - 'video/input/**'
      - 'scripts/render.sh'
      - '.github/workflows/render-video.yml'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  render:
    runs-on: ubuntu-latest
    steps:
      - name: Ambil repo
        uses: actions/checkout@v4

      - name: Pasang ffmpeg
        run: sudo apt-get update && sudo apt-get install -y ffmpeg

      - name: Render video
        run: bash scripts/render.sh

      - name: Simpan video jadi sebagai artifact
        uses: actions/upload-artifact@v4
        with:
          name: video-jadi
          path: video/output/final.mp4
          if-no-files-found: ignore

      - name: Commit video jadi kembali ke repo
        run: |
          if [ -f video/output/final.mp4 ]; then
            git config user.name "github-actions[bot]"
            git config user.email "github-actions[bot]@users.noreply.github.com"
            git add video/output/final.mp4
            git commit -m "Render otomatis: video/output/final.mp4 [skip ci]" || echo "Tidak ada perubahan"
            git push
          else
            echo "Tidak ada hasil render untuk di-commit."
          fi
